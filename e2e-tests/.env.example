# MockIdP Base URL
# ローカル（wrangler dev）の場合
MOCK_IDP_BASE_URL=http://127.0.0.1:8787
# デプロイ済み Worker に向ける場合
# MOCK_IDP_BASE_URL=https://<worker-name>.<subdomain>.workers.dev

# OAuth2 Client Credentials
CLIENT_ID=mockclientid
CLIENT_SECRET=mock-client-secret

# Redirect URI
# MockIdP に登録された値と完全一致している必要がある
REDIRECT_URI=https://localhost:8081/v1/auth/callback

# Test User Credentials
TEST_USER_EMAIL=defaultuser@example.com
TEST_USER_PASSWORD=password

# Organization-specific settings (optional)
# これらは各プロジェクト（dev/staging/production）で上書き可能
# DEV_CLIENT_ID=dev-client-id
# STAGING_CLIENT_ID=staging-client-id
# PRODUCTION_CLIENT_ID=production-client-id
