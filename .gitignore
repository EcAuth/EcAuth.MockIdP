# 依存
node_modules/

# Wrangler / Miniflare のローカル状態
.wrangler/

# wrangler dev 用のローカルシークレット。
# 平文なので絶対にコミットしない（.dev.vars.example のみ追跡する）。
.dev.vars
.dev.vars.*
!.dev.vars.example

# 環境変数（1Password テンプレート .tpl のみ追跡する）
.env
.env.*
!.env.*.tpl

# テスト成果物
coverage/
test-results/
playwright-report/

# エディタ / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
*~
